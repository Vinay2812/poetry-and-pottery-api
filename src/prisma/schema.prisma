// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id      Int      @id @default(autoincrement())
  auth_id String   @unique
  email   String   @unique
  phone   String?
  name    String?
  image   String?
  role    UserRole @default(USER)

  subscribed_to_newsletter Boolean   @default(false)
  newsletter_subscribed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  reviews             Review[]
  likes               ReviewLike[]
  wishlists           Wishlist[]
  carts               Cart[]
  product_orders      ProductOrder[]
  event_registrations          EventRegistration[]
  user_addresses               UserAddress[]
  daily_workshop_registrations DailyWorkshopRegistration[]

  @@map("users")
}

model UserAddress {
  id      Int @id @default(autoincrement())
  user_id Int

  address_line_1 String
  address_line_2 String?
  landmark       String?
  city           String
  state          String
  zip            String
  contact_number String?
  name           String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_addresses")
}

model Product {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique @db.Text
  name               String
  description        String?
  instructions       String[]
  color_code         String
  color_name         String
  material           String
  total_quantity     Int
  available_quantity Int
  is_active          Boolean  @default(true)
  price              Int
  image_urls         String[]
  collection_id      Int?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  purchased_products PurchasedProductItem[]
  product_categories ProductCategory[]
  wishlists          Wishlist[]
  carts              Cart[]
  reviews            Review[]
  collection         Collection?            @relation(fields: [collection_id], references: [id], onDelete: SetNull)

  @@index([price])
  @@index([collection_id])
  @@map("products")
}

model ProductCategory {
  id         Int    @id @default(autoincrement())
  product_id Int
  category   String

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, category])
  @@index([product_id])
  @@map("product_categories")
}

model CustomizeCategory {
  id         Int     @id @default(autoincrement())
  category   String  @unique
  base_price Int     @default(0)
  image_url  String?
  is_active  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  options CustomizationOption[]

  @@index([is_active])
  @@map("customize_categories")
}

model CustomizationOption {
  id                    Int     @id @default(autoincrement())
  customize_category_id Int
  type                  String // Flexible: "SIZE", "COLOR", "SHAPE", "TEXT", or any new type
  name                  String // Display name: "Small", "150ml", "Ocean Blue"
  value                 String // Internal value: "S", "150", "#4682B4"
  price_modifier        Int     @default(0) // Price adjustment in rupees
  sort_order            Int     @default(0)
  is_active             Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  customize_category CustomizeCategory @relation(fields: [customize_category_id], references: [id], onDelete: Cascade)

  @@unique([customize_category_id, type, value]) // Prevent duplicate options (new)
  @@index([customize_category_id])
  @@index([type])
  @@index([is_active])
  @@index([value])
  @@index([price_modifier])
  @@index([sort_order])
  @@map("customization_options")
}

model Collection {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.Text
  name        String
  description String?
  image_url   String?

  // Time-based collection windows (for seasonal/limited collections)
  starts_at DateTime? // When collection becomes visible (null = immediately)
  ends_at   DateTime? // When collection ends (null = no end date)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  products Product[]

  @@index([starts_at])
  @@index([ends_at])
  @@map("collections")
}

enum EventLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  INACTIVE
  CANCELLED
  COMPLETED
}

enum EventType {
  POTTERY_WORKSHOP
  OPEN_MIC
}

model Event {
  id              String      @id @default(nanoid(16))
  slug            String      @unique @db.Text
  title           String
  description     String
  event_type      EventType   @default(POTTERY_WORKSHOP)
  starts_at       DateTime
  ends_at         DateTime
  location        String
  full_location   String
  total_seats     Int         @default(10)
  available_seats Int         @default(10)
  instructor      String?
  includes        String[]
  price           Int
  image           String
  highlights      String[]
  gallery         String[]
  status          EventStatus @default(UPCOMING)
  level           EventLevel?

  // Open Mic specific fields
  performers   String[] @default([])
  lineup_notes String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  reviews             Review[]
  event_registrations EventRegistration[]

  @@index([starts_at])
  @@index([ends_at])
  @@index([event_type])
  @@map("events")
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CONFIRMED
  CANCELLED
}

enum DailyWorkshopRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CONFIRMED
  CANCELLED
}

enum DailyWorkshopBlackoutType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
}

model EventRegistration {
  id             String                  @id @default(nanoid(16))
  event_id       String
  user_id        Int
  seats_reserved Int                     @default(1)
  price          Int
  discount       Int                     @default(0)
  status         EventRegistrationStatus @default(PENDING)
  request_at     DateTime?
  approved_at    DateTime?
  paid_at        DateTime?
  confirmed_at   DateTime?
  cancelled_at   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
  @@map("event_registrations")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  rating     Int
  review     String?
  image_urls String[]

  // Polymorphic - one must be set, not both
  product_id Int?
  event_id   String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  product Product?     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  event   Event?       @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes   ReviewLike[]

  @@unique([product_id, user_id])
  @@unique([event_id, user_id])
  @@index([product_id])
  @@index([event_id])
  @@index([user_id])
  @@map("reviews")
}

model ReviewLike {
  id        Int @id @default(autoincrement())
  review_id Int
  user_id   Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  review Review @relation(fields: [review_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([review_id, user_id])
  @@index([review_id])
  @@index([user_id])
  @@map("review_likes")
}

model Wishlist {
  id         Int @id @default(autoincrement())
  user_id    Int
  product_id Int

  /// [ProductCustomizationData]
  custom_data      Json?
  custom_data_hash String @default("") // Hash of custom_data for uniqueness check

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // Unique on user + product + customization hash (same product with different customizations = separate rows)
  @@unique([user_id, product_id, custom_data_hash])
  @@index([user_id])
  @@index([product_id])
  @@map("wishlists")
}

model Cart {
  id         Int @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int @default(1)

  /// [ProductCustomizationData]
  custom_data      Json?
  custom_data_hash String @default("") // Hash of custom_data for uniqueness check

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // Unique on user + product + customization hash (same product with different customizations = separate rows)
  @@unique([user_id, product_id, custom_data_hash])
  @@index([user_id])
  @@index([product_id])
  @@map("carts")
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model ProductOrder {
  id           String      @id @default(nanoid(16))
  user_id      Int
  shipping_fee Int
  subtotal     Int
  discount     Int         @default(0)
  total        Int
  status       OrderStatus @default(PENDING)
  request_at   DateTime?
  approved_at  DateTime?
  paid_at      DateTime?
  shipped_at   DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  returned_at  DateTime?
  refunded_at  DateTime?

  /// [ShippingAddress]
  shipping_address Json

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  ordered_products PurchasedProductItem[]

  @@map("product_orders")
}

model PurchasedProductItem {
  id         Int    @id @default(autoincrement())
  order_id   String
  product_id Int
  quantity   Int    @default(1)
  discount   Int    @default(0)
  price      Int

  /// [ProductCustomizationData]
  custom_data      Json?
  custom_data_hash String @default("") // Hash of custom_data for uniqueness check

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  order   ProductOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // Unique on order + product + customization hash (same product with different customizations = separate items)
  @@unique([order_id, product_id, custom_data_hash])
  @@index([order_id])
  @@index([product_id])
  @@map("purchased_product_items")
}

// CMS Models

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  /// [SettingValue]
  value Json

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("site_settings")
}

model ContentPage {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  title     String
  /// [ContentBlocks]
  content   Json
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("content_pages")
}

// Daily Workshop Models

model DailyWorkshopConfig {
  id                    Int     @id @default(autoincrement())
  key                   String  @unique @default("default")
  name                  String  @default("Daily Workshop")
  description           String?
  is_active             Boolean @default(true)
  timezone              String  @default("Asia/Kolkata")

  opening_hour          Int     @default(13)
  closing_hour          Int     @default(19)
  slot_duration_minutes Int     @default(60)

  slot_capacity         Int     @default(6)
  booking_window_days   Int     @default(90)

  auto_cancel_on_blackout Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  pricing_tiers  DailyWorkshopPricingTier[]
  blackout_rules DailyWorkshopBlackoutRule[]
  registrations  DailyWorkshopRegistration[]

  @@map("daily_workshop_configs")
}

model DailyWorkshopPricingTier {
  id                Int     @id @default(autoincrement())
  config_id         Int
  hours             Int
  price_per_person  Int
  pieces_per_person Int
  sort_order        Int     @default(0)
  is_active         Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  config DailyWorkshopConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, hours])
  @@index([config_id])
  @@index([is_active])
  @@index([sort_order])
  @@map("daily_workshop_pricing_tiers")
}

model DailyWorkshopBlackoutRule {
  id        String                    @id @default(nanoid(16))
  config_id Int

  name      String
  type      DailyWorkshopBlackoutType
  is_active Boolean                   @default(true)
  timezone  String                    @default("Asia/Kolkata")
  reason    String?

  auto_cancel_existing Boolean @default(true)

  one_time_start_at DateTime?
  one_time_end_at   DateTime?

  recurrence_start_date DateTime?
  recurrence_end_date   DateTime?

  weekdays   Int[] @default([])
  month_days Int[] @default([])

  range_start_minutes Int
  range_end_minutes   Int

  created_by_user_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  config                  DailyWorkshopConfig        @relation(fields: [config_id], references: [id], onDelete: Cascade)
  cancelled_registrations DailyWorkshopRegistration[] @relation("DailyWorkshopCancelledByRule")

  @@index([config_id, is_active])
  @@index([type, is_active])
  @@index([one_time_start_at, one_time_end_at])
  @@index([recurrence_start_date, recurrence_end_date])
  @@index([created_by_user_id])
  @@map("daily_workshop_blackout_rules")
}

model DailyWorkshopRegistration {
  id        String @id @default(nanoid(16))
  config_id Int
  user_id   Int

  participants  Int @default(1)
  total_hours   Int
  slots_count   Int

  price_per_person  Int
  pieces_per_person Int
  base_amount       Int
  discount          Int    @default(0)
  final_amount      Int
  total_pieces      Int
  currency          String @default("INR")

  /// [DailyWorkshopPricingSnapshot]
  pricing_snapshot Json

  status DailyWorkshopRegistrationStatus @default(PENDING)

  request_at   DateTime?
  approved_at  DateTime?
  paid_at      DateTime?
  confirmed_at DateTime?
  cancelled_at DateTime?

  cancelled_reason              String?
  cancelled_by_user_id          Int?
  cancelled_by_blackout_rule_id String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  config                     DailyWorkshopConfig        @relation(fields: [config_id], references: [id], onDelete: Cascade)
  user                       User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cancelled_by_blackout_rule DailyWorkshopBlackoutRule?  @relation("DailyWorkshopCancelledByRule", fields: [cancelled_by_blackout_rule_id], references: [id], onDelete: SetNull)

  slots DailyWorkshopRegistrationSlot[]

  @@index([config_id])
  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([cancelled_by_user_id])
  @@index([cancelled_by_blackout_rule_id])
  @@map("daily_workshop_registrations")
}

model DailyWorkshopRegistrationSlot {
  id              Int      @id @default(autoincrement())
  registration_id String

  slot_start_at DateTime
  slot_end_at   DateTime

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  registration DailyWorkshopRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@unique([registration_id, slot_start_at])
  @@index([slot_start_at])
  @@index([slot_end_at])
  @@index([registration_id])
  @@map("daily_workshop_registration_slots")
}
